# ---- deps: 依存だけ入れる層（package*.json が変わらない限り再利用される）----
FROM docker.io/library/node:26-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# ---- builder: ビルド ----
FROM docker.io/library/node:26-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# VM1 のメモリが 4GiB なので上限を明示しておく
ENV NODE_OPTIONS=--max-old-space-size=3072
RUN npm run build

# ---- runner: 実行に必要な物だけ ----
FROM docker.io/library/node:26-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# 非rootユーザーへの切り替えは意図的に行わない。
# デプロイ先VMのホームには default ACL (other::---) が設定されており、
# rootless podman のイメージ層もその配下に置かれる。コンテナ内の非rootユーザーは
# ホスト上では別uidにマップされるためファイル所有者から見て「その他」に該当し、
# /usr/local/bin/node すら実行できず起動に失敗する。
# rootless podman ではコンテナ内rootもホスト上の非特権uidにマップされるため、
# ホストのroot権限には繋がらない。
# public と .next/static は standalone 出力に含まれないため個別にコピーする
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
# ベースイメージの docker-entrypoint.sh を経由せず直接 node を起動する
ENTRYPOINT []
EXPOSE 3000
CMD ["node", "server.js"]
